{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["jest", "node", "@types/gtag.js"],
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts",
    "src/tests/**/*.ts",
    "src/tests/**/*.tsx"
  ]
}
