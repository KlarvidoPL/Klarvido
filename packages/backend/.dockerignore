__pypackages__
.venv
node_modules
**/node_modules

# Keep private environment files out of image layers and build caches.
**/.env
**/.env.*
**/*.env
**/*.env.*
# Non-secret configuration used by builds, tests, and documentation.
!**/.env.shared
!**/.env.test
!**/.test.env
!**/.env*.example
!**/*.env.example
