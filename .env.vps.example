# =============================================================================
# VPS/SELF-HOSTED ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains the environment variables for docker-compose.prod.yml
# Used for deploying to VPS providers (Hetzner, DigitalOcean, Linode, etc.)
#
# Quick Start:
#   1. Copy this file: cp .env.vps.example .env.prod
#   2. Update all placeholder values
#   3. Run: docker compose -f docker-compose.prod.yml up -d
#
# For detailed guidance, see: packages/internal/docs/docs/deployment/vps.mdx
# =============================================================================

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Your domain must be pointed to your VPS IP address before deployment

# Your main domain (webapp will be at this domain, API at api.DOMAIN)
DOMAIN=example.com

# Email address for Let's Encrypt SSL certificates
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# CONTAINER IMAGES (Required)
# -----------------------------------------------------------------------------
# Built and pushed to GHCR by .github/workflows/deploy-vps.yml on every push
# to master. Replace <owner>/<repo> with your GitHub org/user and repo name
# (lowercase). These stay pinned to :latest - the workflow re-pulls on deploy.

BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:latest
WEBAPP_IMAGE=ghcr.io/<owner>/<repo>-webapp:latest

# -----------------------------------------------------------------------------
# REQUIRED SECRETS (Generate unique values!)
# -----------------------------------------------------------------------------

# Django secret key - used for cryptographic signing
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<GENERATE_ME>

# Salt for HashID field encoding
# Generate with: openssl rand -hex 32
HASHID_FIELD_SALT=<GENERATE_ME>

# PostgreSQL password (used for database container)
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=<GENERATE_ME>

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Choose your storage backend

# Options: local, r2, b2, minio, s3
# - local: Store files on VPS filesystem (default, simplest)
# - r2: Cloudflare R2 (S3-compatible, cheap storage)
# - b2: Backblaze B2 (S3-compatible)
# - minio: Self-hosted MinIO
# - s3: AWS S3
STORAGE_BACKEND=local

# --- Cloudflare R2 (if STORAGE_BACKEND=r2) ---
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# --- Backblaze B2 (if STORAGE_BACKEND=b2) ---
# B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# B2_BUCKET_NAME=

# --- MinIO (if STORAGE_BACKEND=minio) ---
# MINIO_ENDPOINT_URL=http://minio:9000
# MINIO_ACCESS_KEY_ID=
# MINIO_SECRET_ACCESS_KEY=
# MINIO_BUCKET_NAME=

# --- AWS S3 (if STORAGE_BACKEND=s3) ---
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_DEFAULT_REGION are picked up
# automatically by boto3 - only AWS_STORAGE_BUCKET_NAME is read by Django settings.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_STORAGE_BUCKET_NAME=

# -----------------------------------------------------------------------------
# BACKUPS
# -----------------------------------------------------------------------------
# Two independent backup mechanisms:
# 1. Full Postgres dumps -> S3, via scripts/backup-postgres-to-s3.sh + a VPS cron job.
#    Retention is handled by an S3 lifecycle rule on the bucket (not by the script).
# 2. Per-tenant encrypted data exports (apps.backup), scheduled hourly by Celery Beat,
#    configured per-tenant in-app (Organization Settings). Needs BACKUP_MASTER_KEY to
#    encrypt tenant keys at rest (DB fallback - no AWS Secrets Manager on a VPS).
# Both need STORAGE_BACKEND=s3 (or another cloud backend) above - "local" storage
# means exports/uploads only live in a VPS Docker volume, with no offsite copy.

# S3 bucket for Postgres dumps and .env backups (separate from AWS_STORAGE_BUCKET_NAME above)
# BACKUP_S3_BUCKET=

# AWS credentials used ONLY by scripts/backup-*-to-s3.sh. Use a dedicated IAM user (klarvido-backup) whose policy
# allows PutObject/GetObject/ListBucket on the backup prefixes and no delete - never the app's AWS_* key above, so a
# compromised app key cannot remove backups.
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=

# Fernet key encrypting per-tenant backup keys (apps.backup, DB-fallback mode)
# Generate with: openssl rand 32 | base64 | tr '+/' '-_'
# BACKUP_MASTER_KEY=

# KSeF (Krajowy System e-Faktur) - organization KSeF tokens, Polish companies only
# KSEF_ENVIRONMENT: test | demo | prod (one per deployment; use prod only for live invoices)
# KSEF_ENCRYPTION_KEYS: comma-separated AES-256 keys (base64, 32 bytes), newest first. Stored KSeF tokens are
#   encrypted with the first key. Use STANDARD base64 (openssl rand -base64 32), not the URL-safe variant above.
#   Keep an offline copy: losing every key means organizations must re-enter their KSeF tokens.
#   To rotate: put a new key in front, keep the old one behind it, then re-save or re-test tokens.
# KSEF_ENVIRONMENT=test
# KSEF_ENCRYPTION_KEYS=
#
# PRODUCTION (VPS): do NOT set KSEF_ENCRYPTION_KEYS in this file. Put the same content in a secret file instead, so the
# key never appears in the container environment (docker inspect):
#   mkdir -p /opt/klarvido/secrets && chmod 700 /opt/klarvido/secrets
#   (paste the key line into an editor for /opt/klarvido/secrets/ksef_encryption_keys, then)
#   chmod 400 /opt/klarvido/secrets/ksef_encryption_keys && chown root:root /opt/klarvido/secrets/ksef_encryption_keys
# docker-compose.prod.yml mounts it at /run/secrets/ksef_encryption_keys; the backend reads it via
# KSEF_ENCRYPTION_KEYS_FILE. The file must exist before the containers start; without it nothing can be encrypted
# or decrypted (the app fails closed).

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Choose your email backend

# Options:
# - django.core.mail.backends.smtp.EmailBackend (default, generic SMTP)
# - sendgrid_backend.SendgridBackend (SendGrid)
# - django_ses.SESBackend (AWS SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Sender email address (must match your SMTP/provider configuration)
EMAIL_FROM_ADDRESS=noreply@example.com

# Display name shown alongside the address above (e.g. "Klarvido <noreply@example.com>").
# Optional - defaults to "Klarvido".
# EMAIL_FROM_NAME=Klarvido

# --- Generic SMTP (if using SMTP backend) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- SendGrid (if EMAIL_BACKEND=sendgrid_backend.SendgridBackend) ---
# SENDGRID_API_KEY=SG.xxxxxxxx

# --- AWS SES (if EMAIL_BACKEND=django_ses.SESBackend) ---
# Reuses AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY from the storage section above -
# that IAM user's policy needs ses:SendEmail/ses:SendRawEmail on the verified
# identity too. AWS_SES_REGION_NAME is separate from AWS_DEFAULT_REGION (Django-
# specific setting, not read by boto3 automatically). Domain must be verified in
# SES first (DKIM CNAME records + a MAIL FROM subdomain) and production access
# requested (new accounts start in a sandbox: 200 emails/24h, verified recipients
# only) - see packages/internal/docs/docs/deployment/vps.mdx.
# AWS_SES_REGION_NAME=eu-central-1

# -----------------------------------------------------------------------------
# STRIPE PAYMENTS (Optional)
# -----------------------------------------------------------------------------
# Skip if not using payments. You can add these later.

# Start with test keys, switch to live when ready
STRIPE_TEST_SECRET_KEY=sk_test_<CHANGE_ME>
STRIPE_LIVE_SECRET_KEY=sk_live_<CHANGE_ME>
STRIPE_LIVE_MODE=False

# Webhook signing secret
# Webhook URL: https://api.DOMAIN/subscriptions/stripe-webhook/
DJSTRIPE_WEBHOOK_SECRET=whsec_<CHANGE_ME>

# -----------------------------------------------------------------------------
# OAUTH / SOCIAL LOGIN (Optional)
# -----------------------------------------------------------------------------

# Google OAuth2
# Redirect URI: https://api.DOMAIN/auth/social/complete/google-oauth2/
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# Facebook OAuth
# Redirect URI: https://api.DOMAIN/auth/social/complete/facebook/
SOCIAL_AUTH_FACEBOOK_KEY=
SOCIAL_AUTH_FACEBOOK_SECRET=

# -----------------------------------------------------------------------------
# AI FEATURES (Optional)
# -----------------------------------------------------------------------------

# OpenAI API key
OPENAI_API_KEY=

# OpenAI model
# OPENAI_MODEL=gpt-4

# -----------------------------------------------------------------------------
# MONITORING (Optional but Recommended)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
SENTRY_DSN=

# -----------------------------------------------------------------------------
# ADVANCED FEATURES (Optional)
# -----------------------------------------------------------------------------

# 2FA issuer name shown in authenticator apps
OTP_AUTH_ISSUER_NAME=YourAppName

# Celery worker configuration
# CELERY_WORKER_CONCURRENCY=2
# CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# Traefik dashboard authentication (htpasswd format)
# Generate with: htpasswd -nb admin your-password
# TRAEFIK_DASHBOARD_AUTH=admin:$apr1$xxxxx

# WebSocket support (for real-time features)
# WEB_SOCKET_API_ENDPOINT_URL=

# Translation CDN
# TRANSLATIONS_BUCKET_NAME=
# TRANSLATIONS_CLOUDFRONT_ID=

# REQUIRED for accurate IP-based rate limiting and audit logging - the backend sits behind the
# Traefik container, so without this every visitor's request looks like it comes from Traefik's
# own address and shares one rate-limit/throttle bucket. CIDR allow-list of the reverse-proxy
# hop(s) that may supply X-Forwarded-For; only trusted here are forwarded headers honored.
# Find the actual subnet with: docker network inspect web --format '{{json .IPAM.Config}}'
# (the "web" Docker network Traefik and the backend both join, from docker-compose.prod.yml).
# 172.16.0.0/12 covers Docker's entire default bridge-network pool if you'd rather not look it up.
TRUSTED_PROXIES=172.16.0.0/12

# REQUIRED BEFORE MERGING/DEPLOYING the encrypted OTP migration.
# Generate a unique key, store here privately, and back it up separately from PostgreSQL.
# python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Comma-separated base64 AES-256 keys, newest first; retain older keys during rotation.
OTP_ENCRYPTION_KEYS=
AUTH_PASSWORD_RESET_TIMEOUT=3600
RESET_EMAIL_COOLDOWN_SECONDS=300
RESET_EMAIL_DAILY_LIMIT=5
RESET_EMAIL_GLOBAL_HOURLY_LIMIT=500
